<!--    <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-jaxrs</artifactId>
            <version>4.5.9.Final</version>
        </dependency>
    
    <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
